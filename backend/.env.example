# Works with any OpenAI-compatible API.
# Default: Google Gemini (get a key at https://aistudio.google.com/apikey)
OPENAI_API_KEY=your-key-here
OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# flash-lite has generous free-tier quota; gemini-3.6-flash allows only ~20 req/day free
OPENAI_MODEL=gemini-3.1-flash-lite
OPENAI_VISION_MODEL=gemini-3.1-flash-lite
# For OpenAI instead: leave OPENAI_BASE_URL empty and use e.g. gpt-4o-mini
DATABASE_URL=postgresql+psycopg2://vision:vision@localhost:5433/vision
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8081,http://127.0.0.1:8081
UPLOAD_DIR=uploads
